# GitLab Environment Configuration
# Copy this file to .env and update the values

# Database Configuration
POSTGRES_DB=gitlab
POSTGRES_USER=gitlab
POSTGRES_PASSWORD=your_secure_database_password

# GitLab Configuration
GITLAB_ROOT_EMAIL=admin@example.com
GITLAB_ROOT_PASSWORD=your_secure_admin_password
GITLAB_EXTERNAL_URL=http://gitlab.yourdomain.com

# Cloudflare Tunnel Configuration
# Get this token from your Cloudflare dashboard
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here